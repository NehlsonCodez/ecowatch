# ===============================================
# EcoWatch Environment Variables (Railway / Prod)
# ===============================================

# Port (Railway sets this automatically)
PORT=8000

# JWT Authentication Secret Key (Generate a random string for production)
SECRET_KEY=ecowatch-super-secret-key-change-this-in-production-0xDEADBEEF

# Electricity Rate ($ per kWh)
RATE_PER_KWH=0.16

# Simulation Loop Frequency (seconds)
SIMULATION_INTERVAL_SECONDS=5

# Optional Database URL (defaults to SQLite if unset)
# DATABASE_URL=postgresql://user:password@host:port/dbname
